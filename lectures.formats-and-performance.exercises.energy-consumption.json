monthly_mean.band(\"nir\")\n\nndvi = (nir - red) / (nir + red)\n\nndvi.execute().compute()\n\ntracker.stop_experiment()","key":"jxHiDJ02cH"},{"type":"outputs","id":"2QXdkCD8bofg78JfMxTS9","children":[],"key":"H27h60psEG"}],"key":"nRFFQmIshJ"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"strong","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Quiz hint: look carefully energy emission equivalents","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"l9tR55wimA"}],"key":"tJuNkKZ30I"}],"key":"JLXDIF4ZTz"}],"key":"bLJPn9o9uf"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"calculate_emission_equivalents(experiment_id=3)","key":"YJ2sErsnnm"},{"type":"outputs","id":"UYghqnykvjPrMzbdcMNvV","children":[],"key":"gjLwazM6Yb"}],"key":"jWvfIR1ODW"}],"key":"SZ68Q8TJCG"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"2.4 Scaling with Pangeo","url":"/lectures/formats-and-performance/exercises/dask","group":"Data formats for achieving scalability"},"next":{"title":"3.1 Data Processing","url":"/lectures/data-processing/data-processing","group":"Process & Share"}}},"domain":"http://localhost:3000"}