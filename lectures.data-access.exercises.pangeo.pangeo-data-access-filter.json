{"line":1,"column":1}},"key":"pzMP1przmH"},{"type":"text","value":" method from Xarray. Remember to set ","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"myhKUovNcW"},{"type":"inlineCode","value":"drop=True","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"VvhJiqUR21"},{"type":"text","value":" to discard the dates outside the selected period.","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"vZHaSVt0aI"}],"key":"V3cA6UUWFc"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"strong","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"Note","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"pMRCmvtPs4"}],"key":"mIcMU1p8j4"},{"type":"text","value":": We cannot use the sel method to select a slice to filter on the time dimension since the times are not equally spaced.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"V2y4JoXlNf"}],"key":"LvTBHu2m4Q"}],"identifier":"8c56a01b-795b-4b3e-99e2-93622302d955","html_id":"8c56a01b-795b-4b3e-99e2-93622302d955","key":"Pj3q8vR91X"},{"type":"block","kind":"notebook-code","children":[{"type":"code","lang":"python","executable":true,"value":"temporal_slice = datacube.where((datacube.time>=np.datetime64(\"2024-05-10T00:00:00\")) &\n                                (datacube.time<=np.datetime64(\"2024-06-30T00:00:00\")),\n                                drop=True)\ntemporal_slice","key":"tcqOLCuHnf"},{"type":"outputs","id":"hPmRtG1P06P8pHB24V69r","children":[],"key":"Qw0lOp2iR7"}],"identifier":"2feab3cf-87af-47fb-8764-593ef60a293b","html_id":"2feab3cf-87af-47fb-8764-593ef60a293b","key":"TTO9HifBZf"},{"type":"block","kind":"notebook-content","children":[{"type":"paragraph","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Afte