":1}},"key":"jwrTPFnPAv"}],"identifier":"querying-sentinel-2-data-from-a-stac-api","label":"Querying Sentinel-2 data from a STAC API","html_id":"querying-sentinel-2-data-from-a-stac-api","implicit":true,"key":"Q3Ls0aOmtx"},{"type":"paragraph","position":{"start":{"line":3,"column":1},"end":{"line":6,"column":1}},"children":[{"type":"text","value":"Connect to the same public STAC API and search for Sentinel-2 Level-2A products over a specific area (Sardinia) and time range (September 2023).","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"DjPeBlG1uT"},{"type":"break","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"aAp6QYsOYa"},{"type":"text","value":"We will filter the results to include only those items with less than or equal to 20% cloud cover.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"YbxE8tx48n"},{"type":"break","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"PqIuzCOk1r"},{"type":"text","value":"The code retrieves all matching items and prints the number of results, as well as the unique IDs of the returned items.","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ifp9vsA4wc"},{"type":"break","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"NpdgAwIJdC"},{"type":"text","value":"This demonstrates how to query a geospatial data catalog programmatically using the ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"ErVJsCp2cs"},{"type":"inlineCode","value":"pystac-client","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"TbzEBju9Op"},{"type":"text","value":" library- ","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"t5zGCkZq4K"},{"type":"link","url":"https://pystac-client.readthedocs.io/","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"children":[{"type":"text","value":"which documentation can be found here","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"uOXQTnyYkC"}],"urlSource":"https://pystac-client.readthedocs.io/","key":"plJPrDcl9L"},{"type":"text","value":".","position":{"start":{"line":3,"column":1},"end":{"line":3,"column":1}},"key":"Y2iEiM0UBv"}],"key":"nrmmjkdLOX"}],"identifier":"335d898f-2455-4b1d-a82d-bc970a065d8d","html_id":"335d898f-2455-4b1d-a82d-bc970a065d8d","key":"meR7tWMfSL"},{"type":"block","kind":"notebook-code","data":{"tags":[]},"children":[{"type":"code","lang":"python","executable":true,"value":"# Connect to a public STAC API (e.g., Sentinel-2)\ncatalog = Client.open(\"https://earth-search.aws.element84.com/v1\")\n\n# Search for Sentinel-2 items over a specific area and date range\nitems = catalog.search(\n    collections=[\"sentinel-2-l2a\"],\n    datetime=\"2023-09-01/2023-09-30\",\n    bbox=[8.0, 40.0, 9.0, 41.0],  # Example bounding box for Sardinia\n    query={\"eo:cloud_cover\": {\"lte\": 20}}\n).item_collection()\n\n# Print the number of items found\nprint(f\"Number of items found: {len(items)}\\n\")\n\n# Display the IDs of the found items\nprint(\"List of Sentinel-2 ids:\")\nfor item in items:\n    print(item.id)","visibility":"show","key":"FsDMenKZCc"},{"type":"outputs","id":"fMI-6Dvd47wmb6gC5jORO","children":[],"visibility":"show","key":"ZuHv7pOlzU"}],"identifier":"515b0027-10f5-4858-976f-5aad8ffdb7ca","html_id":"515b0027-10f5-4858-976f-5aad8ffdb7ca","visibility":"show","key":"a2aNbWUWCA"},{"type":"block","kind":"notebook-content","children":[{"type":"heading","depth":3,"position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"children":[{"type":"text","value":"Metadata exploration","position":{"start":{"line":1,"column":1},"end":{"line":1,"column":1}},"key":"OB3i98lBAD"}],"identifier":"metadata-exploration","label":"Metadata exploration","html_id":"metadata-exploration","implicit":true,"key":"HF8w6s3Kgi"}],"identifier":"967a92b5-fcb8-4385-b224-a0d0cdbc9ec4","h